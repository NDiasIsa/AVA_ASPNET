@model AVA_ASPNET.Models.Perfil
@{
    ViewData["Title"] = "Minha Turma";
}

<div class="container mt-4">
    <h2 class="titulo mb-1">Minha Turma</h2>
    <p class="text-muted mb-4">
        <strong>@Model.Turma!.NomeExibicao</strong>
        — Prof. @(Model.Turma.Professor?.NomeCompleto ?? "—")
    </p>

    <div class="card shadow-sm">
        <div class="card-header">
            <i class="bi bi-people me-1"></i>
            Colegas de turma — @Model.Turma.Alunos.Count(a => a.Ativo) aluno(s)
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr><th>#</th><th>Nome</th><th>Matrícula</th></tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                        }
                        @foreach (var aluno in Model.Turma.Alunos.Where(a => a.Ativo).OrderBy(a => a.NomeCompleto))
                        {
                            <tr class="@(aluno.Id == Model.Id ? "table-primary fw-semibold" : "")">
                                <td class="text-muted">@(i++)</td>
                                <td>
                                    @aluno.NomeCompleto
                                    @if (aluno.Id == Model.Id)
                                    {
                                        <span class="badge bg-primary ms-1">Você</span>
                                    }
                                </td>
                                <td><code>@aluno.Matricula</code></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
