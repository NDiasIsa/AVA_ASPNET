@model AVA_ASPNET.Models.PublicacaoViewModel
@{
    ViewData["Title"] = "Nova Publicação";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <h2 class="titulo mb-1">Nova Publicação</h2>
            <p class="text-muted mb-4">Seção: <strong>@Model.NomeSecao</strong></p>

            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="CriarPublicacao" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="SecaoId" />
                        <input type="hidden" asp-for="TurmaId" />
                        <input type="hidden" asp-for="NomeSecao" />

                        <div asp-validation-summary="All" class="alert alert-danger"
                             style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

                        <div class="mb-3">
                            <label asp-for="Titulo" class="form-label fw-semibold"></label>
                            <input asp-for="Titulo" class="form-control" placeholder="Título do material" />
                            <span asp-validation-for="Titulo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Descricao" class="form-label fw-semibold"></label>
                            <textarea asp-for="Descricao" class="form-control" rows="3"
                                      placeholder="Instruções ou descrição (opcional)"></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Tipo" class="form-label fw-semibold"></label>
                            <select asp-for="Tipo" class="form-select" id="tipoSelect">
                                <option value="Arquivo">Arquivo</option>
                                <option value="Link">Link</option>
                            </select>
                        </div>

                        <div id="campoArquivo" class="mb-3">
                            <label asp-for="Arquivo" class="form-label fw-semibold"></label>
                            <input asp-for="Arquivo" type="file" class="form-control" />
                            <div class="form-text">PDF, Word, imagem, vídeo, etc.</div>
                        </div>

                        <div id="campoLink" class="mb-3" style="display:none;">
                            <label asp-for="Link" class="form-label fw-semibold"></label>
                            <input asp-for="Link" class="form-control"
                                   placeholder="https://youtube.com/..." />
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle me-1"></i> Publicar
                            </button>
                            <a asp-action="Index" asp-route-turmaId="@Model.TurmaId"
                               class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('tipoSelect').addEventListener('change', function() {
            const isArquivo = this.value === 'Arquivo';
            document.getElementById('campoArquivo').style.display = isArquivo ? 'block' : 'none';
            document.getElementById('campoLink').style.display = isArquivo ? 'none' : 'block';
        });
    </script>
}
