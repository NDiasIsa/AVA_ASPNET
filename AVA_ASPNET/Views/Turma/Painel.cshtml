@model AVA_ASPNET.Models.PainelTurmaViewModel
@{
    ViewData["Title"] = "Painel — " + Model.Turma.NomeExibicao;
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="titulo mb-1">Painel — @Model.Turma.Codigo</h2>
            <p class="text-muted">@Model.Turma.Ano º EM · @Model.Turma.AnoLetivo</p>
        </div>
        <a asp-controller="Turma" asp-action="Index" asp-route-turmaId="@Model.Turma.Id"
           class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Voltar à turma
        </a>
    </div>

    @* Atividades *@
    <h5 class="mb-3"><i class="bi bi-journal-check me-2 text-warning"></i>Atividades</h5>

    @if (!Model.Atividades.Any())
    {
        <div class="alert alert-info mb-4">Nenhuma atividade cadastrada ainda.</div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Atividade</th>
                        <th>Prazo</th>
                        <th>Entregaram</th>
                        <th>Não entregaram</th>
                        <th>Pendente correção</th>
                        <th>Em atraso</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Atividades)
                    {
                        <tr>
                            <td>@a.Titulo</td>
                            <td class="text-muted small">
                                @if (a.Prazo.HasValue)
                                {
                                    <span class="badge @(a.Prazo < DateTime.Now ? "bg-danger" : "bg-secondary")">
                                        @a.Prazo.Value.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><span class="badge bg-success">@a.Entregaram</span></td>
                            <td><span class="badge bg-secondary">@a.NaoEntregaram</span></td>
                            <td>
                                @if (a.PendenteCorrecao > 0)
                                {
                                    <span class="badge bg-warning text-dark">@a.PendenteCorrecao</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">0</span>
                                }
                            </td>
                            <td>
                                @if (a.EmAtraso > 0)
                                {
                                    <span class="badge bg-danger">@a.EmAtraso</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">0</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Turma" asp-action="VerAtividade"
                                   asp-route-atividadeId="@a.AtividadeId"
                                   asp-route-turmaId="@Model.Turma.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* Quiz *@
    <h5 class="mb-3"><i class="bi bi-lightning me-2 text-warning"></i>Quiz</h5>

    @if (!Model.Quizzes.Any())
    {
        <div class="alert alert-info">Nenhum quiz cadastrado ainda.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Quiz</th>
                        <th>Fizeram</th>
                        <th>Não fizeram</th>
                        <th>Média</th>
                        <th>Melhor nota</th>
                        <th>Pior nota</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model.Quizzes)
                    {
                        <tr>
                            <td>@q.Titulo</td>
                            <td><span class="badge bg-success">@q.FizeramQuiz</span></td>
                            <td><span class="badge bg-secondary">@q.NaoFizeram</span></td>
                            <td>
                                <span class="badge @(q.MediaPontuacao >= 60 ? "bg-success" : "bg-danger")">
                                    @q.MediaPontuacao%
                                </span>
                            </td>
                            <td><span class="badge bg-success">@q.MelhorNota%</span></td>
                            <td><span class="badge bg-danger">@q.PiorNota%</span></td>
                            <td>
                                <a asp-controller="Quiz" asp-action="VerResultados"
                                   asp-route-quizId="@q.QuizId"
                                   asp-route-turmaId="@Model.Turma.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-bar-chart"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
