@model AVA_ASPNET.Models.Turma
@{ ViewData["Title"] = "Alunos da Turma"; }

<div class="container mt-4">
    <h2 class="titulo mb-1">Alunos da Turma</h2>
    <p class="text-muted mb-4"><strong>@Model.NomeExibicao</strong></p>

    @if (!Model.Alunos.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i> Nenhum aluno nesta turma ainda.
            <a asp-action="ImportarAlunos" asp-route-turmaId="@Model.Id" class="alert-link ms-1">Importar alunos</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Nome</th>
                        <th>Matrícula</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 1;}
                    @foreach (var aluno in Model.Alunos.OrderBy(a => a.NomeCompleto))
                    {
                        <tr>
                            <td class="text-muted">@(i++)</td>
                            <td>@aluno.NomeCompleto</td>
                            <td><code>@aluno.Matricula</code></td>
                            <td>
                                @if (aluno.PrimeiroAcesso)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-clock me-1"></i>Aguardando 1º acesso
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check me-1"></i>Ativo
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex gap-2 mt-2">
        <a asp-action="ImportarAlunos" asp-route-turmaId="@Model.Id" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-upload me-1"></i> Importar mais alunos
        </a>
        <a asp-action="MinhasTurmas" class="btn btn-link btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar às turmas
        </a>
    </div>
</div>
