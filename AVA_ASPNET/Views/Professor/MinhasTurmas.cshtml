@model List<AVA_ASPNET.Models.Turma>
@{ ViewData["Title"] = "Minhas Turmas"; }

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="titulo mb-0">Minhas Turmas</h2>
        <a asp-action="CriarTurma" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nova Turma
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i> Você ainda não criou nenhuma turma.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var turma in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-door-open me-1"></i> @turma.Codigo
                            </h5>
                            <p class="text-muted small mb-1">@turma.Ano º EM — @turma.AnoLetivo</p>
                            @if (turma.Descricao != null)
                            {
                                <p class="text-muted small mb-2">@turma.Descricao</p>
                            }
                            <span class="badge bg-secondary mb-3">
                                <i class="bi bi-people me-1"></i> @turma.Alunos.Count aluno(s)
                            </span>
                        </div>
                        <div class="card-footer bg-transparent d-flex gap-2">
                            <a asp-action="AlunosDaTurma" asp-route-turmaId="@turma.Id"
                               class="btn btn-sm btn-outline-primary flex-fill">
                                <i class="bi bi-people me-1"></i> Alunos
                            </a>
                            <a asp-action="ImportarAlunos" asp-route-turmaId="@turma.Id"
                               class="btn btn-sm btn-outline-secondary flex-fill">
                                <i class="bi bi-upload me-1"></i> Importar
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
