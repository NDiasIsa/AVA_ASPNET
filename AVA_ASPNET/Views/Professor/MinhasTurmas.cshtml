@model List<AVA_ASPNET.Models.Turma>
@{
    ViewData["Title"] = "Minhas Turmas";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="titulo mb-0">Minhas Turmas</h2>
        <a asp-action="VisaoGeral" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-bar-chart me-1"></i> Visão Geral
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i> Nenhuma turma associada a você ainda.
            Aguarde o administrador associar suas turmas.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var turma in Model)
            {
                <div class="col-md-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-door-open me-1"></i> @turma.Codigo
                            </h5>
                            <p class="text-muted small mb-1">@turma.Ano º EM — @turma.AnoLetivo</p>
                            @if (turma.Descricao != null)
                            {
                                <p class="text-muted small mb-2">@turma.Descricao</p>
                            }
                            <span class="badge bg-secondary mb-3">
                                <i class="bi bi-people me-1"></i> @turma.Alunos.Count aluno(s)
                            </span>
                        </div>
                        <div class="card-footer bg-transparent">
                            <a asp-controller="Turma" asp-action="Index" asp-route-turmaId="@turma.Id"
                               class="btn btn-sm btn-outline-primary w-100">
                                <i class="bi bi-door-open me-1"></i> Abrir Turma
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>