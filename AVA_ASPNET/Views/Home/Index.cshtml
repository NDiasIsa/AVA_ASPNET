@model HomeViewModel
@{
    ViewData["Title"] = "Início";
}

<div class="container">
    <!-- Seção Destaques (Carousel) -->
    <div class="row">
        <div class="col-md-12">
            <h2 class="titulo">DESTAQUES</h2>
            <div id="meuCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (int i = 0; i < Model.Destaques.Count; i++)
                    {
                        <button type="button"
                                data-bs-target="#meuCarousel"
                                data-bs-slide-to="@i"
                                class="@(i == 0 ? "active" : "")"></button>
                    }
                </div>

                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Destaques.Count; i++)
                    {
                        var destaque = Model.Destaques[i];
                        <div class="carousel-item @(i == 0 ? "active" : "")" data-bs-interval="10000">
                            <a class="destaques-link" href="@destaque.Link">
                                <img class="img-destaques" src="@destaque.ImagemUrl" class="d-block w-100" alt="@destaque.Titulo">
                                <label class="assunto-destaques">@destaque.Assunto</label>
                                <label class="manchete-destaques fs-2 fs-md-1">@destaque.Titulo</label>
                            </a>
                        </div>
                    }
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#meuCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#meuCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </div>

    <!-- Divisor -->
    <div class="row">
        <div class="col-md-12">
            <span class="divisor-h-topo"></span>
        </div>
    </div>

    <!-- Seção Notícias -->
    <div class="row">
        @foreach (var noticia in Model.Noticias)
        {
            <div class="col-md-4">
                <div class="noticia">
                    <a class="noticia-link" href="@noticia.Link">
                        <img src="@noticia.ImagemUrl" alt="@noticia.Titulo">
                    </a>
                    <h5 class="assunto">@noticia.Assunto</h5>
                    <a class="noticia-link" href="@noticia.Link">
                        <h3>@noticia.Titulo</h3>
                        <p>@noticia.Descricao</p>
                    </a>
                </div>
                @if (noticia != Model.Noticias.Last())
                {
                    <span class="divisor-v"></span>
                }
            </div>
        }

        <div class="row">
            <div class="col-md-12">
                <span class="divisor-h-baixo"></span>
            </div>
        </div>
    </div>
</div>
