@model AVA_ASPNET.Models.EsqueciSenhaViewModel
@{
    ViewData["Title"] = "Esqueci minha senha";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-key me-2"></i> Esqueci minha senha
                </div>
                <div class="card-body p-4">
                    <p class="text-muted mb-4">
                        Digite sua matrícula (aluno) ou e-mail (professor).
                        Enviaremos instruções para redefinir sua senha.
                    </p>
                    <form asp-action="EsqueciSenha" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-4">
                            <label asp-for="Identificador" class="form-label fw-semibold"></label>
                            <input asp-for="Identificador" class="form-control"
                                   placeholder="Matrícula ou e-mail" />
                            <span asp-validation-for="Identificador" class="text-danger small"></span>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-envelope me-1"></i> Enviar instruções
                        </button>
                    </form>
                    <div class="text-center mt-3">
                        <a asp-action="Login" class="text-muted small">
                            <i class="bi bi-arrow-left me-1"></i> Voltar ao login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
