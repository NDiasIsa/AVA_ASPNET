@model AVA_ASPNET.Models.AssociarProfessorViewModel
@{
    ViewData["Title"] = "Associar Professor";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="titulo mb-1">Associar Professor</h2>
            <p class="text-muted mb-4">Turma: <strong>@Model.NomeTurma</strong></p>
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="AssociarProfessor" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="TurmaId" />
                        <input type="hidden" asp-for="NomeTurma" />
                        <div class="mb-4">
                            <label asp-for="ProfessorId" class="form-label fw-semibold"></label>
                            <select asp-for="ProfessorId" class="form-select">
                                <option value="">— Selecione um professor —</option>
                                @foreach (var prof in Model.ProfessoresDisponiveis)
                                {
                                    <option value="@prof.Id">@prof.NomeCompleto</option>
                                }
                            </select>
                            <span asp-validation-for="ProfessorId" class="text-danger small"></span>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-check me-1"></i> Salvar
                            </button>
                            <a asp-action="Turmas" class="btn btn-outline-secondary">Cancelar</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
