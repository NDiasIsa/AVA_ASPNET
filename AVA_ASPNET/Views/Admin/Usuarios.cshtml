@model List<AVA_ASPNET.Models.Perfil>
@{
    ViewData["Title"] = "Usuários";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="titulo mb-0">Usuários Cadastrados</h2>
        <a asp-action="CriarProfessor" class="btn btn-primary">
            <i class="bi bi-person-plus me-1"></i> Novo Professor
        </a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>Matrícula / E-mail</th>
                    <th>Tipo</th>
                    <th>Turma</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.NomeCompleto</td>
                        <td class="text-muted small">@(p.Matricula ?? p.Usuario?.Email ?? "—")</td>
                        <td>
                            @{
                                var badge = p.TipoUsuario switch { "Admin" => "bg-danger", "Professor" => "bg-primary", _ => "bg-secondary" };
                            }
                            <span class="badge @badge">@p.TipoUsuario</span>
                        </td>
                        <td>@(p.Turma?.NomeExibicao ?? "—")</td>
                        <td>
                            @if (p.TipoUsuario == "Aluno" && p.PrimeiroAcesso)
                            {
                                <span class="badge bg-warning text-dark">Aguardando 1º acesso</span>
                            }
                            else if (!p.Ativo)
                            {
                                <span class="badge bg-secondary">Inativo</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Ativo</span>
                            }
                        </td>
                        <td>
                            @if (p.TipoUsuario != "Admin")
                            {
                                <form asp-action="ExcluirUsuario" method="post" class="d-inline"
                                      onsubmit="return confirm('Excluir @p.NomeCompleto?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="perfilId" value="@p.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a asp-action="Index" class="btn btn-link mt-2">
        <i class="bi bi-arrow-left"></i> Voltar ao painel
    </a>
</div>