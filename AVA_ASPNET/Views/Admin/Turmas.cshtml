@model List<AVA_ASPNET.Models.Turma>
@{ ViewData["Title"] = "Turmas"; }
<div class="container mt-4">
    <h2 class="titulo mb-4">Todas as Turmas</h2>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>Turma</th><th>Ano EM</th><th>Ano letivo</th><th>Professor</th><th>Alunos</th></tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td><strong>@t.Codigo</strong> @(t.Descricao != null ? $"— {t.Descricao}" : "")</td>
                        <td>@t.Ano º EM</td>
                        <td>@t.AnoLetivo</td>
                        <td>@(t.Professor?.NomeCompleto ?? "—")</td>
                        <td><span class="badge bg-secondary">@t.Alunos.Count</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <a asp-action="Index" class="btn btn-link"><i class="bi bi-arrow-left"></i> Voltar ao painel</a>
</div>
