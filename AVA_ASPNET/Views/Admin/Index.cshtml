@{ ViewData["Title"] = "Administração"; }
<div class="container mt-4">
    <h2 class="titulo mb-4">Painel de Administração</h2>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body py-4">
                    <i class="bi bi-people-fill" style="font-size:2.5rem;color:var(--cor-titulo);"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.TotalAlunos</h3>
                    <p class="text-muted mb-0">Alunos</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body py-4">
                    <i class="bi bi-person-workspace" style="font-size:2.5rem;color:var(--cor-titulo);"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.TotalProfessores</h3>
                    <p class="text-muted mb-0">Professores</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body py-4">
                    <i class="bi bi-door-open-fill" style="font-size:2.5rem;color:var(--cor-titulo);"></i>
                    <h3 class="mt-2 mb-0">@ViewBag.TotalTurmas</h3>
                    <p class="text-muted mb-0">Turmas</p>
                </div>
            </div>
        </div>
    </div>
    <div class="row g-3">
        <div class="col-md-4">
            <a asp-action="Usuarios" class="btn btn-outline-primary w-100 py-3">
                <i class="bi bi-people me-2"></i> Gerenciar Usuários
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="CriarProfessor" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-person-plus me-2"></i> Cadastrar Professor
            </a>
        </div>
        <div class="col-md-4">
            <a asp-controller="Professor" asp-action="MinhasTurmas" class="btn btn-outline-secondary w-100 py-3">
                <i class="bi bi-door-open me-2"></i> Ver Turmas
            </a>
        </div>
    </div>
</div>
