# Copie para .env.local e preencha. Na Vercel, cadastre em Settings > Environment Variables.

# Neon: use a conexão com pooler (o host contém "-pooler").
DATABASE_URL=
# Neon: conexão direta, usada apenas pelas migrations.
DATABASE_URL_UNPOOLED=

# Segredo das sessões, com pelo menos 32 caracteres. Gere com: openssl rand -hex 32
AUTH_SECRET=

# Administrador criado por "npm run db:seed". Não precisa ficar na Vercel.
ADMIN_EMAIL=
ADMIN_SENHA=

# Vercel Blob: criado junto com um store PRIVADO, ao conectá-lo ao projeto.
BLOB_READ_WRITE_TOKEN=

# Opcional: senha temporária dos alunos importados. Padrão: [Aluno@123]
# SENHA_INICIAL_ALUNO=

# Só em desenvolvimento, para guardar uploads em .data/ sem conta na Vercel.
# Nesse caso, deixe BLOB_READ_WRITE_TOKEN vazio. Nunca defina esta variável na Vercel.
# NEXT_PUBLIC_UPLOAD_LOCAL=1
